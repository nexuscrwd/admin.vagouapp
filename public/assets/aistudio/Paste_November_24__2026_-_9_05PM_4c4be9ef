              <div className="col-span-6">
                <label className="block text-[11px] font-semibold text-slate-300 mb-1">Cidade *</label>
                <input
                  type="text"
                  value={city}
                  onChange={(e) => setCity(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-[4px] px-2.5 py-2 text-xs text-white outline-none focus:border-emerald-500"
                />
              </div>
              <div className="col-span-2">
                <label className="block text-[11px] font-semibold text-slate-300 mb-1">UF *</label>
                <select
                  value={uf}
                  onChange={(e) => setUf(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-[4px] px-1 py-2 text-xs text-white outline-none focus:border-emerald-500"
                >
                  <option value="">UF</option>
                  {BRAZIL_UF_LIST.map((u) => (
                    <option key={u} value={u}>{u}</option>
                  ))}
                </select>
              </div>
              <div className="col-span-4">
                <label className="block text-[11px] font-semibold text-slate-300 mb-1">
                  CEP {isReverseLookingUpCep ? '...' : ''}
                </label>
                <input
                  type="text"
                  value={cep}
                  onChange={(e) => setCep(formatCEP(e.target.value))}
                  className="w-full bg-slate-950 border border-slate-800 rounded-[4px] px-2 py-2 text-xs text-emerald-400 font-semibold text-center outline-none focus:border-emerald-500"
                />
              </div>
            </div>

            {!isAddressSummaryValid && (
              <p className="text-[11px] text-amber-400 font-medium">
                Falta preencher: {missingAddressFields.join(', ')}.
              </p>
            )}

            <div className="sticky bottom-0 z-20 pt-2 bg-slate-950/90 grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={() => setStep(cameFromManualCep ? 'address_cep' : 'address_num')}
                className="py-3 px-4 rounded-[4px] bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-200 font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap"
              >
                <ArrowLeft className="w-4 h-4" />
                <span>Voltar</span>
              </button>
              <button
                type="button"
                disabled={!isAddressSummaryValid}
                onClick={() => {
                  setFeedback(null);
                  void persistLeadProgress('address_summary');
                  setStep('password');
                }}
                className="py-3 px-4 rounded-[4px] bg-[#20C933] hover:bg-[#1bb32d] disabled:opacity-40 text-white font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap"
              >
                <CheckCircle2 className="w-4 h-4 text-white" />
                <span className="text-white">Confirmar</span>
              </button>
            </div>
          </div>
        )}

        {step === 'password' && (
          <form onSubmit={handleFinalize} className="space-y-3.5">
            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">Crie uma Senha</label>
              <div className="flex items-center bg-slate-950 border border-slate-800 focus-within:border-emerald-500 rounded-[4px] px-3 py-2.5">
                <Lock className="w-4 h-4 text-emerald-400 mr-2 shrink-0" />
                <input
                  type={showPassword ? 'text' : 'password'}
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="Mín. 6 chars, 1 maiúscula e 1 especial"
                  className="bg-transparent text-sm text-white outline-none w-full placeholder:text-slate-500"
                />
                <button
                  type="button"
                  onClick={() => setShowPassword((v) => !v)}
                  className="text-slate-400 hover:text-white ml-2 cursor-pointer"
                >
                  {showPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                </button>
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-300 mb-1">Confirme a Senha</label>
              <div className="flex items-center bg-slate-950 border border-slate-800 focus-within:border-emerald-500 rounded-[4px] px-3 py-2.5">
                <Lock className="w-4 h-4 text-emerald-400 mr-2 shrink-0" />
                <input
                  type={showConfirmPassword ? 'text' : 'password'}
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  placeholder="Repita sua senha"
                  className="bg-transparent text-sm text-white outline-none w-full placeholder:text-slate-500"
                />
                <button
                  type="button"
                  onClick={() => setShowConfirmPassword((v) => !v)}
                  className="text-slate-400 hover:text-white ml-2 cursor-pointer"
                >
                  {showConfirmPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                </button>
              </div>
            </div>

            <div className="p-2.5 rounded-[4px] bg-slate-950 border border-slate-800 space-y-1 text-[11px]">
              <p className={hasMinLength ? 'text-emerald-400' : 'text-slate-400'}>• Mínimo de 6 caracteres</p>
              <p className={hasUpperCase ? 'text-emerald-400' : 'text-slate-400'}>• Ao menos 1 letra maiúscula</p>
              <p className={hasSpecialChar ? 'text-emerald-400' : 'text-slate-400'}>• Ao menos 1 caractere especial</p>
              <p className={passwordsMatch ? 'text-emerald-400' : 'text-slate-400'}>• Confirmação idêntica</p>
            </div>

            <div className="pt-2 border-t border-slate-800 space-y-2">
              <label className="block text-xs font-semibold text-slate-300">
                Pergunta Secreta (Recuperação de Conta)
              </label>
              <button
                type="button"
                onClick={() => setIsQuestionOpen((o) => !o)}
                className="w-full bg-slate-950 border border-slate-800 rounded-[4px] px-3 py-2.5 text-xs text-white text-left flex items-center justify-between gap-2 cursor-pointer"
              >
                <span className="truncate">{selectedQuestion?.questionText}</span>
                <ChevronDown className="w-4 h-4 text-slate-400 shrink-0" />
              </button>
              {isQuestionOpen && (
                <div className="bg-slate-950 border border-slate-700 rounded-[4px] divide-y divide-slate-800">
                  {securityQuestions.map((q) => (
                    <button
                      key={q.code}
                      type="button"
                      onClick={() => {
                        setSecurityQuestionCode(q.code);
                        setIsQuestionOpen(false);
                      }}
                      className="w-full px-3 py-2 text-left text-xs text-slate-200 hover:bg-slate-800 cursor-pointer"
                    >
                      {q.questionText}
                    </button>
                  ))}
                </div>
              )}
              <input
                type="text"
                value={securityAnswer}
                onChange={(e) => setSecurityAnswer(e.target.value)}
                placeholder="Sua resposta secreta"
                className="w-full bg-slate-950 border border-slate-800 rounded-[4px] px-3 py-2 text-xs text-white outline-none focus:border-emerald-500 placeholder:text-slate-500"
              />
            </div>

            <div className="sticky bottom-0 z-20 pt-2 bg-slate-950/90 grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={() => setStep('address_summary')}
                className="py-3 px-4 rounded-[4px] bg-slate-950 hover:bg-slate-800 border border-slate-800 text-slate-200 font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap"
              >
                <ArrowLeft className="w-4 h-4" />
                <span>Voltar</span>
              </button>
              <button
                type="submit"
                disabled={
                  isLoading ||
                  !hasMinLength ||
                  !hasUpperCase ||
                  !hasSpecialChar ||
                  !passwordsMatch ||
                  !isSecurityAnswerValid
                }
                className="py-3 px-4 rounded-[4px] bg-[#20C933] hover:bg-[#1bb32d] disabled:opacity-40 text-white font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap"
              >
                {isLoading ? (
                  <Loader2 className="w-4 h-4 animate-spin text-white" />
                ) : (
                  <>
                    <CheckCircle2 className="w-4 h-4 text-white" />
                    <span className="text-white">Finalizar</span>
                  </>
                )}
              </button>
            </div>
          </form>
        )}

        {step === 'welcome' && (
          <div className="text-center space-y-4 py-2">
            <div className="w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center mx-auto">
              <Sparkles className="w-6 h-6 text-emerald-400" />
            </div>
            <div>
              <h3 className="text-base font-extrabold text-white">Cadastro concluído!</h3>
              <p className="text-xs text-slate-400 mt-1">
                Bem-vindo(a), <strong className="text-white">{cleanName}</strong> ({cleanUsername}).
              </p>
            </div>
            <button
              type="button"
              onClick={() => onClose?.()}
              className="w-full py-3 px-4 rounded-[4px] bg-[#20C933] hover:bg-[#1bb32d] text-white font-bold text-xs cursor-pointer whitespace-nowrap"
            >
              <span className="text-white">Continuar</span>
            </button>
          </div>
        )}
      </div>
    </div>
  );
};
```

