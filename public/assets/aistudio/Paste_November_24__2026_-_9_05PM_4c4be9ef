        });
        return false;
      }
      setPhoneCheck({ status: 'available', message: 'Celular disponível.', checkedValue: digits });
      return true;
    },
    [checkConflict]
  );

  const verifyUsernameNow = useCallback(
    async (val: string) => {
      const clean = val.trim();
      if (
        clean.length < 3 ||
        !/[A-ZÀ-Ý]/.test(clean) ||
        !/[a-zà-ÿ]/.test(clean) ||
        !/[!@#$%^&*()_+\-=[\]{};':"\\|,.<>/?]/.test(clean)
      ) {
        setUsernameCheck(INITIAL_CHECK);
        return false;
      }
      setUsernameCheck({
        status: 'checking',
        message: 'Verificando disponibilidade...',
        checkedValue: clean.toLowerCase(),
      });
      const res = await checkConflict({ username: clean });
      if (res.conflict) {
        setUsernameCheck({
          status: 'taken',
          message: res.message || 'Este nome de usuário já está em uso.',
          checkedValue: clean.toLowerCase(),
        });
        return false;
      }
      setUsernameCheck({
        status: 'available',
        message: 'Nome de usuário disponível.',
        checkedValue: clean.toLowerCase(),
      });
      return true;
    },
    [checkConflict]
  );

  const verifyEmailNow = useCallback(
    async (val: string) => {
      const clean = val.trim().toLowerCase();
      if (!isValidEmail(clean)) {
        setEmailCheck(INITIAL_CHECK);
        return false;
      }
      setEmailCheck({ status: 'checking', message: 'Verificando e-mail...', checkedValue: clean });
      const res = await checkConflict({ email: clean });
      if (res.conflict) {
        setEmailCheck({
          status: 'taken',
          message: res.message || 'Este e-mail já está cadastrado.',
          checkedValue: clean,
        });
        return false;
      }
      setEmailCheck({ status: 'available', message: 'E-mail disponível.', checkedValue: clean });
      return true;
    },
    [checkConflict]
  );

  const verifyRiskNow = useCallback(
    async (fullNameValue: string) => {
      if (bypassAntifraud) {
        return { blocked: false, requiresConfirmation: false, message: '' };
      }
      const norm = normalizeText(fullNameValue);
      const parts = norm.split(' ').filter((p) => p.length >= 2);
      if (parts.length < 2) {
        return { blocked: false, requiresConfirmation: false, message: '' };
      }

      const activeHash = deviceHash || (await getOrCreateDeviceFingerprint());
      setRiskCheck((prev) => ({ ...prev, status: 'checking' }));

      let evaluated: any = null;
      try {
        const res = await fetch('/api/public/check-registration-risk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            fullName: fullNameValue.trim(),
            deviceHash: activeHash,
            cep: cep.replace(/\D/g, ''),
          }),
        });
        const ct = res.headers.get('content-type') || '';
        if (res.ok && ct.includes('application/json')) {
          evaluated = await res.json();
        }
      } catch {}

      if (!evaluated && supabase) {
        try {
          const { data } = await (supabase.rpc as any)('check_registration_risk_rpc', {
            p_full_name: fullNameValue.trim(),
            p_device_hash: activeHash || null,
            p_cep: cep.replace(/\D/g, '') || null,
          });
          if (data) evaluated = data;
        } catch {}
      }

      const result = {
        status: 'done' as const,
        riskLevel: (evaluated?.riskLevel || 'low') as 'low' | 'medium' | 'high',
        riskScore: Number(evaluated?.riskScore || 0),
        requiresConfirmation: Boolean(evaluated?.requiresConfirmation),
        blocked: Boolean(evaluated?.blocked),
        message: String(evaluated?.message || ''),
        checkedName: norm,
      };
      setRiskCheck(result);
      return result;
    },
    [bypassAntifraud, cep, deviceHash]
  );

  useEffect(() => {
    if (step !== 'contact' || !isPhoneFormatValid) return;
    if (phoneCheck.checkedValue === phoneDigits && phoneCheck.status !== 'idle') return;
    const t = setTimeout(() => void verifyPhoneNow(phone), 320);
    return () => clearTimeout(t);
  }, [step, phone, phoneDigits, isPhoneFormatValid, phoneCheck.checkedValue, phoneCheck.status, verifyPhoneNow]);

  useEffect(() => {
    if (step !== 'name' || !isUsernameFormatValid) return;
    if (usernameCheck.checkedValue === cleanUsername.toLowerCase() && usernameCheck.status !== 'idle') {
      return;
    }
    const t = setTimeout(() => void verifyUsernameNow(cleanUsername), 320);
    return () => clearTimeout(t);
  }, [step, cleanUsername, isUsernameFormatValid, usernameCheck.checkedValue, usernameCheck.status, verifyUsernameNow]);

  useEffect(() => {
    if (step !== 'name' || bypassAntifraud) return;
    const norm = normalizeText(cleanName);
    if (norm.split(' ').filter((p) => p.length >= 2).length < 2) return;
    if (riskCheck.checkedName === norm && riskCheck.status === 'done') return;
    setRiskAcknowledged(false);
    const t = setTimeout(() => void verifyRiskNow(cleanName), 450);
    return () => clearTimeout(t);
  }, [step, cleanName, bypassAntifraud, riskCheck.checkedName, riskCheck.status, verifyRiskNow]);

  useEffect(() => {
    if (step !== 'email' || !isEmailFormatValid) return;
    if (emailCheck.checkedValue === cleanEmail && emailCheck.status !== 'idle') return;
    const t = setTimeout(() => void verifyEmailNow(cleanEmail), 320);
    return () => clearTimeout(t);
  }, [step, cleanEmail, isEmailFormatValid, emailCheck.checkedValue, emailCheck.status, verifyEmailNow]);

  useEffect(() => {
    if (step !== 'address_cep') return;
    const q = addressSearchQuery.trim();
    if (q.length < 3) {
      setAddressSuggestions([]);
      setIsSearchingPlaces(false);
      return;
    }
    let cancelled = false;
    setIsSearchingPlaces(true);
    const t = setTimeout(async () => {
      try {
        const res = await fetch('/api/maps/places-autocomplete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ input: q, sessionToken: placesSessionTokenRef.current }),
        });
        const ct = res.headers.get('content-type') || '';
        if (!cancelled && res.ok && ct.includes('application/json')) {
          const data = await res.json();
          setAddressSuggestions(Array.isArray(data?.suggestions) ? data.suggestions : []);
        }
      } catch {}
      if (!cancelled) setIsSearchingPlaces(false);
    }, 300);
    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [step, addressSearchQuery]);

  useEffect(() => {
    if (step !== 'address_summary') return;
    if (cep.replace(/\D/g, '').length === 8) return;
    const cleanStreet = street.trim();
    const cleanCity = city.trim();
    const cleanUf = uf.trim().toUpperCase();
    if (cleanStreet.length < 3 || cleanCity.length < 2 || cleanUf.length !== 2) return;

    let cancelled = false;
    const t = setTimeout(async () => {
      setIsReverseLookingUpCep(true);
      try {
        const streetCore = stripStreetPrefix(cleanStreet);
        const url = `https://viacep.com.br/ws/${encodeURIComponent(cleanUf)}/${encodeURIComponent(cleanCity)}/${encodeURIComponent(streetCore)}/json/`;
        const res = await fetch(url);
        if (res.ok && !cancelled) {
          const data = await res.json();
          if (Array.isArray(data) && data.length > 0) {
            const rawCep = String(data[0]?.cep || '').replace(/\D/g, '');
            if (rawCep.length === 8) setCep(formatCEP(rawCep));
          }
        }
      } catch {}
      if (!cancelled) setIsReverseLookingUpCep(false);
    }, 450);

    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [step, street, city, uf, cep]);

  const persistLeadProgress = async (
    targetStep: 'contact' | 'name' | 'email' | 'address_summary'
  ) => {
    if (!isPhoneFormatValid) return;
    const activeHash = deviceHash || (await getOrCreateDeviceFingerprint());
    const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    const validSalonId = salonId && uuidPattern.test(salonId) ? salonId : null;

    if (supabase) {
      try {
        const { error } = await (supabase.rpc as any)('upsert_registration_lead_rpc', {
          p_phone: phone.trim(),
          p_last_step: targetStep,
          p_origin: origin,
          p_salon_id: validSalonId,
          p_salon_slug: salonSlug?.trim() || null,
          p_device_hash: activeHash || null,
          p_full_name: cleanName || null,
          p_username: cleanUsername || null,
          p_email: cleanEmail || null,
          p_cep: cep.trim() || null,
          p_street: street.trim() || null,
          p_street_number: addressNumber.trim() || null,
          p_complement: complement.trim() || null,
          p_neighborhood: neighborhood.trim() || null,
          p_city: city.trim() || null,
          p_state: uf.trim().toUpperCase() || null,
          p_latitude: addressCoords?.lat ?? null,
          p_longitude: addressCoords?.lng ?? null,
        });
        if (!error) return;
      } catch {}
    }

    try {
      await fetch('/api/public/registration-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          phone: phone.trim(),
          lastStep: targetStep,
          origin,
          salonId: validSalonId,
          salonSlug: salonSlug?.trim() || null,
          deviceHash: activeHash || null,
          fullName: cleanName || null,
          username: cleanUsername || null,
          email: cleanEmail || null,
          cep: cep.trim() || null,
          street: street.trim() || null,
          number: addressNumber.trim() || null,
          complement: complement.trim() || null,
          neighborhood: neighborhood.trim() || null,
          city: city.trim() || null,
          uf: uf.trim().toUpperCase() || null,
          lat: addressCoords?.lat ?? null,
          lng: addressCoords?.lng ?? null,
        }),
      });
    } catch {}
  };

  const tryResumeLead = async (phoneValue: string): Promise<boolean> => {
    const activeHash = deviceHash || (await getOrCreateDeviceFingerprint());
    if (!activeHash || activeHash.length < 12) return false;

    let lead: Record<string, any> | null = null;
    if (supabase) {
      try {
        const { data, error } = await (supabase.rpc as any)('get_registration_lead_resume_rpc', {
          p_phone: phoneValue.trim(),
          p_device_hash: activeHash,
        });
        if (!error && data?.found && data?.lead) lead = data.lead;
      } catch {}
    }

    if (!lead) return false;
    let hydrated = false;
    if (!name.trim() && lead.fullName) { setName(lead.fullName); hydrated = true; }
    if (!username.trim() && lead.username) {
      setUsername(lead.username);
      setConfirmUsername(lead.username);
      hydrated = true;
    }
    if (!email.trim() && lead.email) {
      setEmail(lead.email);
      setConfirmEmail(lead.email);
      hydrated = true;
    }
    if (!cep.trim() && lead.cep) { setCep(formatCEP(lead.cep)); hydrated = true; }
    if (!street.trim() && lead.street) { setStreet(lead.street); hydrated = true; }
    if (!addressNumber.trim() && lead.number) { setAddressNumber(lead.number); hydrated = true; }
    if (!complement.trim() && lead.complement) setComplement(lead.complement);
    if (!neighborhood.trim() && lead.neighborhood) setNeighborhood(lead.neighborhood);
    if (!city.trim() && lead.city) setCity(lead.city);
    if (!uf.trim() && lead.uf) setUf(String(lead.uf).toUpperCase());
    if (!addressCoords && typeof lead.lat === 'number' && typeof lead.lng === 'number') {
      setAddressCoords({ lat: lead.lat, lng: lead.lng });
    }
    return hydrated;
  };

  const handleSelectGooglePlace = async (item: GoogleAddressSuggestion) => {
    setFeedback(null);
    setCepNotFound(false);
    setIsResolvingPlace(true);
    try {
      const res = await fetch('/api/maps/place-details', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          placeId: item.placeId,
          sessionToken: placesSessionTokenRef.current,
        }),
      });
      placesSessionTokenRef.current = createPlacesSessionToken();
      const ct = res.headers.get('content-type') || '';
      if (!res.ok || !ct.includes('application/json')) {
        setFeedback({ type: 'error', message: 'Não foi possível detalhar este endereço. Use o CEP.' });
        return;
      }
      const d = await res.json();
      setStreet(d.street || '');
      if (d.number) setAddressNumber(d.number);
      setNeighborhood(d.neighborhood || '');
      setCity(d.city || '');
      setUf(String(d.uf || '').toUpperCase());
      if (d.cep) setCep(formatCEP(d.cep));
      if (typeof d.lat === 'number' && typeof d.lng === 'number') {
        setAddressCoords({ lat: d.lat, lng: d.lng });
      }
      setAddressSearchQuery('');
      setAddressSuggestions([]);
      setCameFromManualCep(false);
      setStep(d.number ? 'address_summary' : 'address_num');
    } catch {
      setFeedback({ type: 'error', message: 'Falha ao buscar endereço. Digite o CEP abaixo.' });
    } finally {
      setIsResolvingPlace(false);
    }
  };

  const lookupCep = async (rawCep: string) => {
    const digits = rawCep.replace(/\D/g, '');
    if (digits.length !== 8) return;
    setIsLookingUpCep(true);
    setCepNotFound(false);
    try {
      let found: any = null;
      try {
        const r = await fetch(`https://viacep.com.br/ws/${digits}/json/`);
        if (r.ok) {
          const j = await r.json();
          if (j && !j.erro) {
            found = { street: j.logradouro, neighborhood: j.bairro, city: j.localidade, uf: j.uf };
          }
        }
      } catch {}

      if (!found) {
        try {
          const r2 = await fetch(`https://brasilapi.com.br/api/cep/v2/${digits}`);
          if (r2.ok) {
            const j2 = await r2.json();
            if (j2?.city) {
              found = { street: j2.street, neighborhood: j2.neighborhood, city: j2.city, uf: j2.state };
            }
          }
        } catch {}
      }

      if (!found) {
        setCepNotFound(true);
        return;
      }
      setStreet(found.street || '');
      setNeighborhood(found.neighborhood || '');
      setCity(found.city || '');
      setUf(String(found.uf || '').toUpperCase());
      setCameFromManualCep(false);
      setStep('address_num');
    } finally {
      setIsLookingUpCep(false);
    }
  };

  const handleAdvanceContact = async () => {
    if (isLoading) return;
    setFeedback(null);
    if (!isPhoneFormatValid) {
      setFeedback({ type: 'error', message: 'Digite um celular / WhatsApp válido com DDD.' });
      return;
    }
    if (phoneDigits !== confirmPhoneDigits) {
      setFeedback({ type: 'error', message: 'Os números de celular digitados não coincidem.' });
      return;
    }
    setIsLoading(true);
    try {
      const ok =
        phoneCheck.status === 'available' && phoneCheck.checkedValue === phoneDigits
          ? true
          : await verifyPhoneNow(phone);
      if (!ok) return;
      const resumed = await tryResumeLead(phone);
      void persistLeadProgress('contact');
      if (resumed) {
        setFeedback({
          type: 'success',
          message: 'Retomamos os dados que você já havia preenchido neste aparelho.',
        });
      }
      setStep('name');
    } finally {
      setIsLoading(false);
    }
  };

  const handleAdvanceName = async () => {
    if (isLoading) return;
    setFeedback(null);
    if (cleanName.length < 2) {
      setFeedback({ type: 'error', message: 'Informe seu nome completo.' });
      return;
    }
    if (!isUsernameFormatValid) {
      setFeedback({
        type: 'error',
        message: 'Mínimo 3 caracteres, 1 maiúscula, 1 minúscula e 1 especial (Ex: João@).',
      });
      return;
    }
    if (!isUsernameConfirmed) {
      setFeedback({ type: 'error', message: 'Os nomes de usuário digitados não coincidem.' });
      return;
    }
    setIsLoading(true);
    try {
      const ok =
        usernameCheck.status === 'available' &&
        usernameCheck.checkedValue === cleanUsername.toLowerCase()
          ? true
          : await verifyUsernameNow(cleanUsername);
      if (!ok) return;

      const norm = normalizeText(cleanName);
      const riskRes =
        bypassAntifraud
          ? { blocked: false, requiresConfirmation: false, message: '' }
          : riskCheck.status === 'done' && riskCheck.checkedName === norm
            ? riskCheck
            : await verifyRiskNow(cleanName);

      if (riskRes.blocked) {
        setFeedback({
          type: 'error',
          message: riskRes.message || 'Limite temporário de cadastros neste dispositivo atingido.',
        });
        return;
      }
      if (riskRes.requiresConfirmation && !riskAcknowledged) {
        setFeedback({
          type: 'error',
          message: 'Confirme abaixo que se trata de um cadastro individual ou entre na conta existente.',
        });
        return;
      }
      void persistLeadProgress('name');
      setStep('email');
    } finally {
      setIsLoading(false);
    }
  };

  const handleAdvanceEmail = async () => {
    if (isLoading) return;
    setFeedback(null);
    if (!isEmailFormatValid) {
      setFeedback({ type: 'error', message: 'Informe um e-mail válido.' });
      return;
    }
    if (cleanEmail !== cleanConfirmEmail) {
      setFeedback({ type: 'error', message: 'Os e-mails informados não coincidem.' });
      return;
    }
    setIsLoading(true);
    try {
      const ok =
        emailCheck.status === 'available' && emailCheck.checkedValue === cleanEmail
          ? true
          : await verifyEmailNow(cleanEmail);
      if (!ok) return;
      void persistLeadProgress('email');
      setStep('address_cep');
    } finally {
      setIsLoading(false);
    }
  };

  const handleFinalize = async (e: React.FormEvent) => {
    e.preventDefault();
    setFeedback(null);
    if (!hasMinLength || !hasUpperCase || !hasSpecialChar || !passwordsMatch) {
      setFeedback({
        type: 'error',
        message: 'A senha deve ter mínimo 6 caracteres, 1 maiúscula, 1 especial e confirmação idêntica.',
      });
      return;
    }
    if (!isSecurityAnswerValid) {
      setFeedback({ type: 'error', message: 'Informe uma resposta secreta (mínimo 2 caracteres).' });
      return;
    }

    setIsLoading(true);
    try {
      const effectiveNum = addressNumber.trim() || 'S/N';
      const addressObj: TriadeUserAddressData = {
        cep: formatCEP(cep),
        street: street.trim(),
        number: effectiveNum,
        complement: complement.trim(),
        neighborhood: neighborhood.trim(),
        city: city.trim(),
        uf: uf.trim().toUpperCase(),
      };
      const fullAddressString = `${addressObj.street}, ${addressObj.number}${
        addressObj.complement ? ` (${addressObj.complement})` : ''
      } - ${addressObj.neighborhood}, ${addressObj.city} - ${addressObj.uf}${
        addressObj.cep ? `, ${addressObj.cep}` : ''
      }`;
      const canonicalSecCode = normalizeSecurityQuestionCode(securityQuestionCode);
      const normalizedSecAnswer = normalizeText(securityAnswer);
      const activeHash = deviceHash || (await getOrCreateDeviceFingerprint());

      let persistedUserId = '';
      let persistedClientId = '';
      let apiJsonHandled = false;

      try {
        const res = await fetch('/api/public/register-user', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name: cleanName,
            username: cleanUsername,
            email: cleanEmail,
            phone: phone.trim(),
            password: password.trim(),
            address: addressObj.street,
            street: addressObj.street,
            number: addressObj.number,
            complement: addressObj.complement,
            neighborhood: addressObj.neighborhood,
            city: addressObj.city,
            uf: addressObj.uf,
            cep: addressObj.cep,
            formatted_address: fullAddressString,
            lat: addressCoords?.lat ?? null,
            lng: addressCoords?.lng ?? null,
            deviceHash: activeHash,
            riskAcknowledged: riskAcknowledged || bypassAntifraud,
            security_question_code: canonicalSecCode,
            security_answer: normalizedSecAnswer,
            account_type: 'client',
            origin,
          }),
        });
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          apiJsonHandled = true;
          const json = await res.json();
          if (!res.ok || json?.success === false || json?.conflict) {
            throw new Error(json?.error || 'Não foi possível concluir o cadastro.');
          }
          persistedUserId = String(json.userId || '');
          persistedClientId = String(json.clientId || json.client?.id || '');
        }
      } catch (apiErr: any) {
        if (apiJsonHandled) throw apiErr;
      }

      if (!persistedUserId && !apiJsonHandled && supabase) {
        const { data: signUpData, error: signUpErr } = await supabase.auth.signUp({
          email: cleanEmail,
          password: password.trim(),
          options: {
            data: {
              full_name: cleanName,
              name: cleanName,
              username: cleanUsername,
              phone: phone.trim(),
              address: fullAddressString,
              formatted_address: fullAddressString,
              cep: addressObj.cep,
              street: addressObj.street,
              number: addressObj.number,
              complement: addressObj.complement,
              neighborhood: addressObj.neighborhood,
              city: addressObj.city,
              uf: addressObj.uf,
              latitude: addressCoords?.lat ?? null,
              longitude: addressCoords?.lng ?? null,
              device_hash: activeHash || null,
              security_question_code: canonicalSecCode,
              security_answer: normalizedSecAnswer,
              created_via: origin,
            },
          },
        });
        if (signUpErr) throw new Error(signUpErr.message);
        if (!signUpData?.user?.id) throw new Error('Falha ao confirmar criação da conta.');
        persistedUserId = String(signUpData.user.id);
      }

      if (!persistedUserId) {
        throw new Error('Não foi possível gravar o usuário no banco de dados.');
      }

      if (supabase) {
        try {
          await (supabase.rpc as any)('complete_registration_lead_rpc', {
            p_phone: phone.trim(),
            p_user_id: persistedUserId,
            p_client_id: persistedClientId || null,
          });
        } catch {}
      }

      onSuccess?.(
        {
          id: persistedUserId,
          name: cleanName,
          username: cleanUsername,
          email: cleanEmail,
          phone: phone.trim(),
          address: addressObj,
          accountType: 'client',
        },
        { keepModalOpen: true }
      );
      setStep('welcome');
    } catch (err: any) {
      setFeedback({ type: 'error', message: err?.message || 'Erro ao finalizar cadastro.' });
    } finally {
      setIsLoading(false);
    }
  };

  const currentMeta = STEP_META[step];
  const selectedQuestion =
    securityQuestions.find((q) => q.code === securityQuestionCode) || securityQuestions[0];

  return (
    <div
      className={`vagou-cinematic-auth w-full max-w-md mx-auto text-white ${
        variant === 'card'
          ? 'bg-slate-950/95 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden'
          : ''
      }`}
    >
      <div className="relative px-6 pt-5 pb-3 border-b border-slate-800/80 text-center">
        {onClose && (
          <button
            type="button"
            onClick={onClose}
            aria-label="Fechar"
            className="absolute top-4 right-4 p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer"
          >
            <X className="w-4 h-4" />
          </button>
        )}
        {salonLogoUrl ? (
          <img
            src={salonLogoUrl}
            alt={salonName || 'VagouApp'}
            className="h-9 max-w-[180px] object-contain mx-auto mb-1.5"
          />
        ) : (
          <h2 className="text-lg font-extrabold tracking-tight text-white">
            {salonName || 'VagouApp'}
          </h2>
        )}
        <p className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
          CRIAR CONTA • {currentMeta.label}
        </p>
      </div>

      <div className="px-6 pb-6 pt-4">
        {step !== 'welcome' && (
          <div className="mb-4">
            <div className="flex items-center justify-between text-[11px] font-bold text-slate-400 mb-1.5">
              <span className="text-emerald-400 uppercase tracking-wider">{currentMeta.label}</span>
