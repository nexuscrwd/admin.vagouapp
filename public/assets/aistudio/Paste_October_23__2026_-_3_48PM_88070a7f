CREATE OR REPLACE FUNCTION public.sync_services_to_salon_services()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF pg_trigger_depth() > 1 THEN
        RETURN COALESCE(NEW, OLD);
    END IF;

    IF TG_OP = 'DELETE' THEN
        DELETE FROM public.salon_services WHERE id = OLD.id OR service_id = OLD.id;
        RETURN OLD;
    END IF;

    INSERT INTO public.salon_services (
        id, salon_id, service_id, name, title, custom_name, category, price, promotional_price,
        duration_minutes, duration_estimated, commission_rate, description, image_url, video_url, photos, videos, slides,
        target_audience, order_index, is_active, created_at, updated_at
    ) VALUES (
        NEW.id, NEW.salon_id, NEW.id, NEW.name, NEW.title, NEW.custom_name, NEW.category, NEW.price, NEW.promotional_price,
        NEW.duration_minutes, COALESCE(NEW.duration_estimated, NEW.duration_minutes || ' min'), NEW.commission_rate, NEW.description, NEW.image_url, NEW.video_url, NEW.photos, NEW.videos, NEW.slides,
        NEW.target_audience, NEW.order_index, NEW.is_active, NEW.created_at, NOW()
    )
    ON CONFLICT (id) DO UPDATE SET
        salon_id = EXCLUDED.salon_id,
        service_id = EXCLUDED.service_id,
        name = EXCLUDED.name,
        title = EXCLUDED.title,
        custom_name = EXCLUDED.custom_name,
        category = EXCLUDED.category,
        price = EXCLUDED.price,
        promotional_price = EXCLUDED.promotional_price,
        duration_minutes = EXCLUDED.duration_minutes,
        duration_estimated = EXCLUDED.duration_estimated,
        commission_rate = EXCLUDED.commission_rate,
        description = EXCLUDED.description,
        image_url = EXCLUDED.image_url,
        video_url = EXCLUDED.video_url,
        photos = EXCLUDED.photos,
        videos = EXCLUDED.videos,
        slides = EXCLUDED.slides,
        target_audience = EXCLUDED.target_audience,
        order_index = EXCLUDED.order_index,
        is_active = EXCLUDED.is_active,
        updated_at = NOW();

    RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.trg_appointments_client_limits()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  IF auth.uid() IS NULL OR public.is_platform_admin() OR public.is_salon_member(OLD.salon_id) THEN
    RETURN NEW;
  END IF;
  IF (to_jsonb(NEW) - 'status' - 'updated_at') IS DISTINCT FROM (to_jsonb(OLD) - 'status' - 'updated_at')
     OR NEW.status <> 'CANCELADO' THEN
    RAISE EXCEPTION 'Clientes só podem cancelar o próprio agendamento'
      USING ERRCODE = '42501';
  END IF;
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION public.trg_appointments_reserve_offer()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  IF NEW.offer_id IS NOT NULL THEN
    UPDATE public.service_offers
       SET status = 'RESERVED', updated_at = now()
     WHERE id = NEW.offer_id
       AND salon_id = NEW.salon_id
       AND status = 'AVAILABLE'
       AND expires_at > now();
    IF NOT FOUND THEN
      RAISE EXCEPTION 'Esta vaga não está mais disponível' USING ERRCODE = 'P0001';
    END IF;
  END IF;
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION public.trg_salon_owner_member()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  IF NEW.owner_id IS NOT NULL THEN
    INSERT INTO public.salon_members (salon_id, user_id, role)
    VALUES (NEW.id, NEW.owner_id, 'owner')
    ON CONFLICT (salon_id, user_id) DO NOTHING;
  END IF;
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION public.trg_salons_protect_fields()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  col TEXT;
BEGIN
  IF auth.uid() IS NULL OR public.is_platform_admin() THEN
    RETURN NEW;
  END IF;
  FOREACH col IN ARRAY ARRAY[
    'owner_id', 'is_verified', 'status', 'billing_plan',
    'billing_fee_type', 'billing_fee_value', 'commission_rate'
  ] LOOP
    IF (to_jsonb(NEW) -> col) IS DISTINCT FROM (to_jsonb(OLD) -> col) THEN
      RAISE EXCEPTION 'Campo % só pode ser alterado pelo administrador da plataforma', col
        USING ERRCODE = '42501';
    END IF;
  END LOOP;
  RETURN NEW;
END $function$;

CREATE OR REPLACE FUNCTION public.verify_admin_login(p_login text, p_password text)
 RETURNS TABLE(id uuid, full_name character varying, username character varying, email character varying, phone_whatsapp character varying, role character varying, access_level character varying, avatar_url text)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_admin RECORD;
BEGIN
    SELECT a.id, a.full_name, a.username, a.email, a.phone_whatsapp, a.password_hash, a.role, a.access_level, a.avatar_url, a.is_active
    INTO v_admin
    FROM public.system_admins a
    WHERE (LOWER(a.username) = LOWER(p_login) OR LOWER(a.email) = LOWER(p_login) OR a.phone_whatsapp = p_login)
    LIMIT 1;

    IF v_admin.id IS NOT NULL AND v_admin.is_active = TRUE THEN
        IF v_admin.password_hash = crypt(p_password, v_admin.password_hash) THEN
            UPDATE public.system_admins
            SET last_login_at = NOW()
            WHERE system_admins.id = v_admin.id;

            RETURN QUERY SELECT v_admin.id, v_admin.full_name, v_admin.username, v_admin.email, v_admin.phone_whatsapp, v_admin.role, v_admin.access_level, v_admin.avatar_url;
        END IF;
    END IF;
END;
$function$;

