CREATE OR REPLACE FUNCTION public.add_salon_member_by_email(p_salon_id uuid, p_email text, p_role text DEFAULT 'professional'::text)
 RETURNS json
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user UUID;
BEGIN
  IF NOT (public.is_salon_owner(p_salon_id) OR public.is_platform_admin()) THEN
    RAISE EXCEPTION 'Apenas o dono do salão pode adicionar membros' USING ERRCODE = '42501';
  END IF;
  IF p_role NOT IN ('manager', 'professional') THEN
    RAISE EXCEPTION 'Papel inválido: use manager ou professional';
  END IF;
  SELECT id INTO v_user FROM auth.users WHERE lower(email) = lower(trim(p_email));
  IF v_user IS NULL THEN
    RETURN json_build_object('ok', FALSE, 'error', 'Nenhuma conta encontrada com este e-mail');
  END IF;
  INSERT INTO public.salon_members (salon_id, user_id, role)
  VALUES (p_salon_id, v_user, p_role)
  ON CONFLICT (salon_id, user_id) DO UPDATE SET role = EXCLUDED.role
    WHERE public.salon_members.role <> 'owner';
  RETURN json_build_object('ok', TRUE, 'user_id', v_user, 'role', p_role);
END $function$;

CREATE OR REPLACE FUNCTION public.auto_promote_service_to_radar()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
DECLARE
    v_existing_offer_id UUID;
    v_default_prof_id UUID;
BEGIN
    IF NEW.promotional_price IS NOT NULL
       AND NEW.promotional_price > 0
       AND NEW.promotional_price < NEW.price
       AND COALESCE(NEW.is_active, TRUE) = TRUE
    THEN
        SELECT id INTO v_existing_offer_id
        FROM public.service_offers
        WHERE salon_id = NEW.salon_id
          AND service_id = NEW.id
          AND status = 'AVAILABLE'
        ORDER BY created_at DESC
        LIMIT 1;

        IF v_existing_offer_id IS NOT NULL THEN
            UPDATE public.service_offers
            SET service_title = COALESCE(NEW.title, NEW.name, 'Oferta Relâmpago'),
                category = COALESCE(NEW.category, 'cabelo'),
                price = NEW.promotional_price,
                original_price = NEW.price,
                video_url = NEW.video_url,
                description = COALESCE(NEW.description, description),
                expires_at = GREATEST(expires_at, NOW() + INTERVAL '8 hours'),
                updated_at = NOW()
            WHERE id = v_existing_offer_id;
        ELSE
            SELECT id INTO v_default_prof_id
            FROM public.professionals
            WHERE salon_id = NEW.salon_id
            ORDER BY created_at ASC
            LIMIT 1;

            INSERT INTO public.service_offers (
                salon_id, professional_id, service_id, service_title, category,
                price, original_price, date_str, start_time, end_time,
                status, media_level, video_url, is_flash_deal, expires_at, description
            ) VALUES (
                NEW.salon_id,
                v_default_prof_id,
                NEW.id,
                COALESCE(NEW.title, NEW.name, 'Oferta Relâmpago'),
                COALESCE(NEW.category, 'cabelo'),
                NEW.promotional_price,
                NEW.price,
                TO_CHAR(NOW(), 'YYYY-MM-DD'),
                '14:30:00',
                '15:15:00',
                'AVAILABLE',
                CASE WHEN NEW.video_url IS NOT NULL AND TRIM(NEW.video_url) <> '' THEN 3 ELSE 1 END,
                NEW.video_url,
                TRUE,
                NOW() + INTERVAL '8 hours',
                NEW.description
            );
        END IF;
    END IF;

    RETURN NEW;
END;
$function$;

CREATE OR REPLACE FUNCTION public.get_busy_slots(p_salon_id uuid, p_date_str text)
 RETURNS TABLE(professional_id uuid, start_time time without time zone, end_time time without time zone)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT a.professional_id, a.start_time, a.end_time
  FROM public.appointments a
  WHERE a.salon_id = p_salon_id
    AND a.date_str = p_date_str
    AND a.status NOT IN ('CANCELADO', 'NO_SHOW');
$function$;

CREATE OR REPLACE FUNCTION public.get_offers_in_radius(user_lat double precision, user_lng double precision, radius_km double precision DEFAULT 25.0, filter_category text DEFAULT NULL::text)
 RETURNS TABLE(offer_id uuid, salon_id uuid, salon_name character varying, salon_neighborhood character varying, salon_address text, salon_logo text, salon_logo_light text, salon_logo_dark text, operating_model character varying, home_delivery_enabled boolean, home_delivery_area text, home_delivery_travel_fee numeric, professional_name character varying, professional_avatar text, rating_avg numeric, rating_count integer, service_title character varying, category character varying, price numeric, original_price numeric, date_str character varying, start_time time without time zone, end_time time without time zone, media_level integer, video_url text, gallery_images text[], distance_meters integer, distance_km numeric, expires_at timestamp with time zone)
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
    RETURN QUERY
    SELECT
        so.id AS offer_id,
        s.id AS salon_id,
        s.trade_name AS salon_name,
        s.neighborhood AS salon_neighborhood,
        s.address AS salon_address,
        s.logo_url AS salon_logo,
        s.logo_light_url AS salon_logo_light,
        s.logo_dark_url AS salon_logo_dark,
        s.operating_model,
        s.home_delivery_enabled,
        s.home_delivery_area,
        s.home_delivery_travel_fee,
        COALESCE(p.name, s.trade_name) AS professional_name,
        p.avatar_url AS professional_avatar,
        s.rating_avg,
        s.rating_count,
        so.service_title,
        so.category,
        so.price,
        so.original_price,
        so.date_str,
        so.start_time,
        so.end_time,
        so.media_level,
        so.video_url,
        so.gallery_images,
        ROUND(
            (6371000 * acos(
                LEAST(1.0, GREATEST(-1.0,
                    cos(radians(user_lat)) * cos(radians(s.latitude)) *
                    cos(radians(s.longitude) - radians(user_lng)) +
                    sin(radians(user_lat)) * sin(radians(s.latitude))
                ))
            ))
        )::INTEGER AS distance_meters,
        ROUND(
            ((6371 * acos(
                LEAST(1.0, GREATEST(-1.0,
                    cos(radians(user_lat)) * cos(radians(s.latitude)) *
                    cos(radians(s.longitude) - radians(user_lng)) +
                    sin(radians(user_lat)) * sin(radians(s.latitude))
                ))
            )))::NUMERIC, 1
        ) AS distance_km,
        so.expires_at
    FROM
        public.service_offers so
        JOIN public.salons s ON so.salon_id = s.id
        LEFT JOIN public.professionals p ON so.professional_id = p.id
    WHERE
        so.status = 'AVAILABLE'
        AND so.expires_at > NOW()
        AND (filter_category IS NULL OR filter_category = 'todos' OR LOWER(so.category) = LOWER(filter_category))
    ORDER BY
        so.expires_at ASC;
END;
$function$;

CREATE OR REPLACE FUNCTION public.handle_appointment_defaults()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$
BEGIN
    IF NEW.protocol_code IS NULL OR TRIM(NEW.protocol_code) = '' THEN
        NEW.protocol_code := '#VGA-' || UPPER(SUBSTRING(REPLACE(uuid_generate_v4()::TEXT, '-', ''), 1, 6));
    END IF;

    NEW.service_title := COALESCE(NEW.service_title, NEW.service_name, 'Procedimento');
    NEW.service_name := COALESCE(NEW.service_name, NEW.service_title, 'Procedimento');
    NEW.price := COALESCE(NEW.price, NEW.service_price, 0.00);
    NEW.service_price := COALESCE(NEW.service_price, NEW.price, 0.00);
    NEW.date_str := COALESCE(NEW.date_str, NEW.scheduled_date, TO_CHAR(NOW(), 'YYYY-MM-DD'));
    NEW.scheduled_date := COALESCE(NEW.scheduled_date, NEW.date_str);

    IF NEW.client_id IS NULL AND NEW.client_user_id IS NOT NULL THEN
        IF EXISTS (SELECT 1 FROM public.clients WHERE id = NEW.client_user_id) THEN
            NEW.client_id := NEW.client_user_id;
        END IF;
    END IF;
    IF NEW.client_user_id IS NULL AND NEW.client_id IS NOT NULL THEN
        NEW.client_user_id := NEW.client_id;
    END IF;

    IF NEW.final_price IS NULL THEN
        NEW.final_price := GREATEST(0, COALESCE(NEW.price, 0) - COALESCE(NEW.discount, 0));
    END IF;

    -- Se o agendamento veio de uma Cadeira Vazia do Radar (offer_id), marca como BOOKED automaticamente!
    IF TG_OP = 'INSERT' AND NEW.offer_id IS NOT NULL THEN
        UPDATE public.service_offers
        SET status = 'BOOKED',
            updated_at = NOW()
        WHERE id = NEW.offer_id;
    END IF;

    IF TG_OP = 'INSERT' AND NEW.client_id IS NOT NULL THEN
        UPDATE public.clients
        SET total_appointments = COALESCE(total_appointments, 0) + 1,
            updated_at = NOW()
        WHERE id = NEW.client_id;
    END IF;

    RETURN NEW;
END;
$function$;

