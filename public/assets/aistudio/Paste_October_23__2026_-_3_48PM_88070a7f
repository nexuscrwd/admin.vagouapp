CREATE OR REPLACE FUNCTION public.register_triade_user(p_email character varying, p_full_name character varying, p_phone character varying, p_role character varying DEFAULT 'consumer'::character varying, p_password_hash text DEFAULT NULL::text, p_cpf character varying DEFAULT NULL::character varying, p_address text DEFAULT NULL::text, p_street_number character varying DEFAULT NULL::character varying, p_complement character varying DEFAULT NULL::character varying, p_neighborhood character varying DEFAULT NULL::character varying, p_city character varying DEFAULT 'São Paulo'::character varying, p_state character varying DEFAULT 'SP'::character varying, p_cep character varying DEFAULT NULL::character varying, p_salon_id uuid DEFAULT NULL::uuid, p_origin_type character varying DEFAULT 'portal'::character varying)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_user_id UUID;
    v_client_id UUID;
    v_username VARCHAR;
BEGIN
    v_username := LOWER(REGEXP_REPLACE(SPLIT_PART(p_email, '@', 1), '[^a-zA-Z0-9_]', '_', 'g'));

    INSERT INTO public.profiles (
        email, full_name, name, username, phone, phone_whatsapp, cpf, role,
        address, street_number, complement, neighborhood, city, state, cep, salon_id
    ) VALUES (
        LOWER(p_email), p_full_name, p_full_name, v_username, p_phone, p_phone, p_cpf, p_role,
        p_address, p_street_number, p_complement, p_neighborhood, p_city, p_state, p_cep, p_salon_id
    )
    ON CONFLICT (id) DO UPDATE SET
        full_name = EXCLUDED.full_name,
        phone = EXCLUDED.phone,
        phone_whatsapp = EXCLUDED.phone_whatsapp,
        updated_at = NOW()
    RETURNING id INTO v_user_id;

    IF p_role = 'consumer' THEN
        INSERT INTO public.clients (
            id, name, full_name, username, email, phone, phone_whatsapp, cpf,
            address, street_number, complement, neighborhood, city, state, cep, origin_type, origin_salon_id
        ) VALUES (
            v_user_id, p_full_name, p_full_name, v_username, LOWER(p_email), p_phone, p_phone, p_cpf,
            p_address, p_street_number, p_complement, p_neighborhood, p_city, p_state, p_cep, p_origin_type, p_salon_id
        )
        ON CONFLICT (id) DO UPDATE SET
            name = EXCLUDED.name,
            full_name = EXCLUDED.full_name,
            phone = EXCLUDED.phone,
            phone_whatsapp = EXCLUDED.phone_whatsapp,
            updated_at = NOW()
        RETURNING id INTO v_client_id;
    END IF;

    RETURN jsonb_build_object(
        'success', true,
        'profile_id', v_user_id,
        'client_id', v_client_id,
        'username', v_username,
        'role', p_role
    );
END;
$function$;

CREATE OR REPLACE FUNCTION public.register_triade_user(p_full_name character varying, p_username character varying, p_phone character varying, p_email character varying, p_password_hash text, p_cep character varying, p_street character varying, p_number character varying, p_complement character varying, p_neighborhood character varying, p_city character varying, p_state character varying, p_origin_type character varying DEFAULT 'portal'::character varying, p_origin_salon_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_client_id UUID;
    v_result JSONB;
BEGIN
    -- Localiza cliente existente por email ou telefone
    SELECT id INTO v_client_id
    FROM public.clients
    WHERE LOWER(email) = LOWER(p_email) OR phone = p_phone
    LIMIT 1;

    IF v_client_id IS NOT NULL THEN
        UPDATE public.clients SET
            name = p_full_name,
            username = COALESCE(p_username, username),
            password_hash = COALESCE(p_password_hash, password_hash),
            cep = p_cep,
            address = p_street,
            street_number = p_number,
            complement = p_complement,
            neighborhood = p_neighborhood,
            city = p_city,
            state = p_state,
            updated_at = NOW()
        WHERE id = v_client_id;
    ELSE
        INSERT INTO public.clients (
            name, username, phone, email, password_hash,
            cep, address, street_number, complement, neighborhood, city, state,
            origin_type, origin_salon_id
        ) VALUES (
            p_full_name, p_username, p_phone, LOWER(p_email), p_password_hash,
            p_cep, p_street, p_number, p_complement, p_neighborhood, p_city, p_state,
            p_origin_type, p_origin_salon_id
        ) RETURNING id INTO v_client_id;
    END IF;

    -- Se houver salão de origem, insere/atualiza vínculo instantâneo na carteira do salão
    IF p_origin_salon_id IS NOT NULL THEN
        INSERT INTO public.salon_clients (
            salon_id, client_id, source, last_interaction_at
        ) VALUES (
            p_origin_salon_id, v_client_id, 'embed_form', NOW()
        )
        ON CONFLICT (salon_id, client_id) DO UPDATE SET
            last_interaction_at = NOW(),
            updated_at = NOW();
    END IF;

    v_result := jsonb_build_object(
        'success', true,
        'client_id', v_client_id,
        'full_name', p_full_name,
        'email', p_email,
        'origin_salon_id', p_origin_salon_id
    );

    RETURN v_result;
END;
$function$;

