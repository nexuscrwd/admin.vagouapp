CREATE OR REPLACE FUNCTION public.upsert_registration_lead_rpc(
  p_phone TEXT,
  p_last_step TEXT DEFAULT 'contact',
  p_origin TEXT DEFAULT 'mnvapp',
  p_salon_id UUID DEFAULT NULL,
  p_salon_slug TEXT DEFAULT NULL,
  p_device_hash TEXT DEFAULT NULL,
  p_full_name TEXT DEFAULT NULL,
  p_username TEXT DEFAULT NULL,
  p_email TEXT DEFAULT NULL,
  p_cep TEXT DEFAULT NULL,
  p_street TEXT DEFAULT NULL,
  p_street_number TEXT DEFAULT NULL,
  p_complement TEXT DEFAULT NULL,
  p_neighborhood TEXT DEFAULT NULL,
  p_city TEXT DEFAULT NULL,
  p_state TEXT DEFAULT NULL,
  p_latitude DOUBLE PRECISION DEFAULT NULL,
  p_longitude DOUBLE PRECISION DEFAULT NULL
)
RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_raw_digits TEXT := regexp_replace(COALESCE(p_phone, ''), '\D', '', 'g');
  v_phone_digits TEXT;
  v_step TEXT := lower(btrim(COALESCE(p_last_step, 'contact')));
  v_origin TEXT := left(lower(btrim(COALESCE(p_origin, 'mnvapp'))), 32);
  v_resolved_salon_id UUID := NULL;
  v_clean_slug TEXT := NULLIF(left(lower(btrim(COALESCE(p_salon_slug, ''))), 120), '');
  v_device TEXT := NULLIF(left(btrim(COALESCE(p_device_hash, '')), 64), '');
  v_full_name TEXT := NULLIF(left(btrim(COALESCE(p_full_name, '')), 140), '');
  v_username TEXT := NULLIF(left(btrim(COALESCE(p_username, '')), 60), '');
  v_email TEXT := NULLIF(left(lower(btrim(COALESCE(p_email, ''))), 160), '');
  v_cep TEXT := NULLIF(left(btrim(COALESCE(p_cep, '')), 12), '');
  v_street TEXT := NULLIF(left(btrim(COALESCE(p_street, '')), 180), '');
  v_number TEXT := NULLIF(left(btrim(COALESCE(p_street_number, '')), 24), '');
  v_complement TEXT := NULLIF(left(btrim(COALESCE(p_complement, '')), 100), '');
  v_neighborhood TEXT := NULLIF(left(btrim(COALESCE(p_neighborhood, '')), 120), '');
  v_city TEXT := NULLIF(left(btrim(COALESCE(p_city, '')), 120), '');
  v_state TEXT := NULLIF(left(upper(btrim(COALESCE(p_state, ''))), 4), '');
  v_lead_id UUID;
BEGIN
  IF length(v_raw_digits) >= 12 AND left(v_raw_digits, 2) = '55' THEN
    v_phone_digits := substr(v_raw_digits, 3);
  ELSE
    v_phone_digits := v_raw_digits;
  END IF;

  IF length(v_phone_digits) < 10 OR length(v_phone_digits) > 11 THEN
    RETURN jsonb_build_object('ok', FALSE, 'error', 'invalid_phone');
  END IF;

  IF v_step NOT IN ('contact', 'name', 'email', 'address_cep', 'address_num', 'address_summary', 'security') THEN
    v_step := 'contact';
  END IF;

  IF v_origin = '' THEN
    v_origin := 'mnvapp';
  END IF;

  IF p_salon_id IS NOT NULL THEN
    SELECT s.id INTO v_resolved_salon_id
    FROM public.salons s
    WHERE s.id = p_salon_id
    LIMIT 1;
  END IF;

  IF v_resolved_salon_id IS NULL AND v_clean_slug IS NOT NULL THEN
    SELECT s.id INTO v_resolved_salon_id
    FROM public.salons s
    WHERE lower(s.slug) = v_clean_slug
    LIMIT 1;
  END IF;

  SELECT rl.id INTO v_lead_id
  FROM public.registration_leads rl
  WHERE rl.phone_digits = v_phone_digits
    AND rl.status = 'in_progress'
  LIMIT 1;

  IF v_lead_id IS NOT NULL THEN
    UPDATE public.registration_leads
    SET
      phone = left(btrim(p_phone), 32),
      salon_id = COALESCE(v_resolved_salon_id, salon_id),
      salon_slug = COALESCE(v_clean_slug, salon_slug),
      origin = COALESCE(NULLIF(v_origin, ''), origin),
      device_hash = COALESCE(v_device, device_hash),
      full_name = COALESCE(v_full_name, full_name),
      username = COALESCE(v_username, username),
      email = COALESCE(v_email, email),
      cep = COALESCE(v_cep, cep),
      street = COALESCE(v_street, street),
      street_number = COALESCE(v_number, street_number),
      complement = COALESCE(v_complement, complement),
      neighborhood = COALESCE(v_neighborhood, neighborhood),
      city = COALESCE(v_city, city),
      state = COALESCE(v_state, state),
      latitude = COALESCE(p_latitude, latitude),
      longitude = COALESCE(p_longitude, longitude),
      last_step = v_step,
      expires_at = NOW() + INTERVAL '30 days',
      updated_at = NOW()
    WHERE id = v_lead_id;
  ELSE
    INSERT INTO public.registration_leads (
      phone, phone_digits, salon_id, salon_slug, origin, device_hash,
      full_name, username, email, cep, street, street_number, complement,
      neighborhood, city, state, latitude, longitude, last_step, status, expires_at
    )
    VALUES (
      left(btrim(p_phone), 32), v_phone_digits, v_resolved_salon_id, v_clean_slug, v_origin, v_device,
      v_full_name, v_username, v_email, v_cep, v_street, v_number, v_complement,
      v_neighborhood, v_city, v_state, p_latitude, p_longitude, v_step, 'in_progress', NOW() + INTERVAL '30 days'
    )
    RETURNING id INTO v_lead_id;
  END IF;

  RETURN jsonb_build_object('ok', TRUE, 'leadId', v_lead_id, 'lastStep', v_step);
END;
$$;

GRANT EXECUTE ON FUNCTION public.upsert_registration_lead_rpc(
  TEXT, TEXT, TEXT, UUID, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, DOUBLE PRECISION, DOUBLE PRECISION
) TO anon, authenticated;

CREATE OR REPLACE FUNCTION public.get_registration_lead_resume_rpc(
  p_phone TEXT,
  p_device_hash TEXT
)
RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_raw_digits TEXT := regexp_replace(COALESCE(p_phone, ''), '\D', '', 'g');
  v_phone_digits TEXT;
  v_device TEXT := left(btrim(COALESCE(p_device_hash, '')), 64);
  v_row public.registration_leads%ROWTYPE;
BEGIN
  IF length(v_raw_digits) >= 12 AND left(v_raw_digits, 2) = '55' THEN
    v_phone_digits := substr(v_raw_digits, 3);
  ELSE
    v_phone_digits := v_raw_digits;
  END IF;

  IF length(v_phone_digits) < 10 OR length(v_phone_digits) > 11 OR length(v_device) < 12 THEN
    RETURN jsonb_build_object('found', FALSE);
  END IF;

  SELECT * INTO v_row
  FROM public.registration_leads rl
  WHERE rl.phone_digits = v_phone_digits
    AND rl.device_hash = v_device
    AND rl.status = 'in_progress'
    AND rl.updated_at >= NOW() - INTERVAL '7 days'
  ORDER BY rl.updated_at DESC
  LIMIT 1;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('found', FALSE);
  END IF;

  RETURN jsonb_build_object(
    'found', TRUE,
    'lead', jsonb_build_object(
      'id', v_row.id,
      'fullName', COALESCE(v_row.full_name, ''),
      'username', COALESCE(v_row.username, ''),
      'email', COALESCE(v_row.email, ''),
      'cep', COALESCE(v_row.cep, ''),
      'street', COALESCE(v_row.street, ''),
      'number', COALESCE(v_row.street_number, ''),
      'complement', COALESCE(v_row.complement, ''),
      'neighborhood', COALESCE(v_row.neighborhood, ''),
      'city', COALESCE(v_row.city, ''),
      'uf', COALESCE(v_row.state, ''),
      'lat', v_row.latitude,
      'lng', v_row.longitude,
      'lastStep', v_row.last_step,
      'updatedAt', v_row.updated_at
    )
  );
END;
$$;

GRANT EXECUTE ON FUNCTION public.get_registration_lead_resume_rpc(TEXT, TEXT) TO anon, authenticated;

CREATE OR REPLACE FUNCTION public.complete_registration_lead_rpc(
  p_phone TEXT,
  p_user_id UUID DEFAULT NULL,
  p_client_id UUID DEFAULT NULL
)
RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_raw_digits TEXT := regexp_replace(COALESCE(p_phone, ''), '\D', '', 'g');
  v_phone_digits TEXT;
  v_valid_user_id UUID := NULL;
  v_valid_client_id UUID := NULL;
  v_updated_count INTEGER := 0;
BEGIN
  IF length(v_raw_digits) >= 12 AND left(v_raw_digits, 2) = '55' THEN
    v_phone_digits := substr(v_raw_digits, 3);
  ELSE
    v_phone_digits := v_raw_digits;
  END IF;

  IF length(v_phone_digits) < 10 OR length(v_phone_digits) > 11 THEN
    RETURN jsonb_build_object('ok', FALSE, 'updated', 0);
  END IF;

  IF p_user_id IS NOT NULL THEN
    SELECT u.id INTO v_valid_user_id FROM auth.users u WHERE u.id = p_user_id LIMIT 1;
  END IF;

  IF p_client_id IS NOT NULL THEN
    SELECT c.id INTO v_valid_client_id FROM public.clients c WHERE c.id = p_client_id LIMIT 1;
  END IF;

  UPDATE public.registration_leads
  SET
    status = 'completed',
    last_step = 'completed',
    converted_user_id = COALESCE(v_valid_user_id, converted_user_id),
    converted_client_id = COALESCE(v_valid_client_id, converted_client_id),
    completed_at = NOW(),
    updated_at = NOW()
  WHERE phone_digits = v_phone_digits
    AND status IN ('in_progress', 'abandoned');

  GET DIAGNOSTICS v_updated_count = ROW_COUNT;

  RETURN jsonb_build_object('ok', TRUE, 'updated', v_updated_count);
END;
$$;

GRANT EXECUTE ON FUNCTION public.complete_registration_lead_rpc(TEXT, UUID, UUID) TO anon, authenticated;

CREATE OR REPLACE FUNCTION public.purge_expired_registration_leads()
RETURNS INTEGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_deleted INTEGER := 0;
BEGIN
  UPDATE public.registration_leads
  SET status = 'abandoned', updated_at = NOW()
  WHERE status = 'in_progress'
    AND updated_at < NOW() - INTERVAL '24 hours';

  DELETE FROM public.registration_leads
  WHERE status IN ('in_progress', 'abandoned')
    AND expires_at < NOW();

  GET DIAGNOSTICS v_deleted = ROW_COUNT;
  RETURN v_deleted;
END;
$$;

COMMIT;
